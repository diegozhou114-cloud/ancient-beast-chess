{
  "name": "ancient-beast-chess",
  "private": true,
  "version": "1.0.0",
  "description": "A 4x5 blind beast-chess game with AI, LAN, and online play.",
  "author": "diegozhou114-cloud",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:renderer": "vite --host 127.0.0.1 --port 4173",
    "desktop": "npm run server:build && concurrently -k \"npm run dev:renderer\" \"wait-on http://127.0.0.1:4173 && ELECTRON_RENDERER_URL=http://127.0.0.1:4173 electron .\"",
    "build": "tsc -b && vite build",
    "test": "vitest run tests/game.test.ts tests/online.test.ts && node --test tests/lan.test.cjs",
    "test:lan:20": "npm run server:build && node server/scripts/lan-e2e.mjs 20",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "server:test": "npm --prefix server test",
    "server:build": "npm --prefix server run build",
    "server:pack:check": "npm run server:build && node server/scripts/verify-package.mjs",
    "server:pack": "npm run server:pack:check && npm pack ./server",
    "package:mac": "npm run build && npm run server:build && electron-builder --config.directories.output=release/macos --mac --arm64 --publish never",
    "package:win": "npm run build && npm run server:build && electron-builder --config.directories.output=release/windows --win zip --x64 --publish never"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.diegozhou.ancientbeastchess",
    "productName": "Ancient Beast Chess",
    "asar": true,
    "files": [
      "dist/**",
      "electron/*.cjs",
      "server/dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "electron/icon.icns",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Ancient Beast Chess"
    },
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "zip"
      ],
      "artifactName": "Ancient-Beast-Chess-${version}-win-${arch}.${ext}"
    }
  }
}
